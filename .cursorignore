# Cursor Workspace Token Filter
# Prevents large generated/cache files from consuming LLM context tokens.
# Kept in sync with .antigravityignore and .ignore (see openspec/config.yaml -> token_efficiency).

# Build artifacts & compiled bundles
client/dist/**
dist/**
build/**
*.bundle.js
*.min.js
*.min.css
*.map

# Android / Gradle build artifacts
.gradle/**
android/.gradle/**
android/build/**
android/app/build/**
*.apk
*.aab

# Generated Android sync targets (copies of server/ and client/dist/ -- never the source)
android/app/src/main/assets/client_dist/**
android/app/src/main/python/server/**

# Dependencies & Environments
.venv/**
venv/**
node_modules/**
client/node_modules/**

# Lockfiles (large, generated, never hand-edited)
uv.lock
package-lock.json
client/package-lock.json

# Testing and Linters caches
.pytest_cache/**
.ruff_cache/**
.coverage
coverage/**
htmlcov/**
client/coverage/**

# Logs & Transcripts
*.log
*.jsonl
npm-debug.log*

# OS & Temporary Files
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
