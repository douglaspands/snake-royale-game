android/app/build/
android/local.properties
android/app/src/main/assets/client_dist/
android/app/src/main/python/server/
*.apk
*.aab

# Android signing material — never commit; losing it prevents publishing
# updates installable over an existing install. See REQ-AND-009.
*.keystore
*.jks
android/keystore.properties

# PyInstaller desktop builds (REQ-DESK-001/002) — dist/ and build/ above already
# cover the default output dirs; these are the rest of a local build's leftovers.
*.spec
release_output/

# Local `gh run download` artifact folders (Android APK, desktop executables)
dist-apk/

